# kcal-log Docker Compose Environment Configuration
HTTP_PORT=8088
APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_URL=http://localhost:8088

# MariaDB Database Configuration
DB_DATABASE=kcal_log
DB_USERNAME=kcal_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Redis
REDIS_PASSWORD=

# Reverb WebSockets
REVERB_APP_ID=kcal-log-app
REVERB_APP_KEY=kcal-log-reverb-key
REVERB_APP_SECRET=
REVERB_PORT=9080

# Automatic Migrations on Startup
RUN_MIGRATIONS=true
