# ==============================================================================
# kcal-log Root .gitignore
# Covers: Laravel, Node, Vite+, Android, Expo, IDE, OS, Secrets, Keystores
# ==============================================================================

# --- Secrets & Environment (Strict: Public Repository) ---
.env
.env.*
!.env.example
!.env.testing.example
*.key
*.pem
*.p12
*.jks
*.keystore
secrets/
storage/*.key
oauth-*.key
oauth-*.pub

# --- Node & Package Managers ---
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# --- Vite+ & Build Artifacts ---
dist/
build/
out/
public/build/
public/hot
.vite/
.vite-plus/
.vitest/
.tsdown/
coverage/
*.tsbuildinfo

# --- Laravel Framework & Temporary Files ---
/vendor/
/apps/web/vendor/
/apps/web/storage/app/*
!/apps/web/storage/app/.gitignore
/apps/web/storage/app/public/*
!/apps/web/storage/app/public/.gitignore
/apps/web/storage/framework/cache/data/*
!/apps/web/storage/framework/cache/data/.gitignore
/apps/web/storage/framework/sessions/*
!/apps/web/storage/framework/sessions/.gitignore
/apps/web/storage/framework/testing/*
!/apps/web/storage/framework/testing/.gitignore
/apps/web/storage/framework/views/*
!/apps/web/storage/framework/views/.gitignore
/apps/web/storage/logs/*
!/apps/web/storage/logs/.gitignore
/apps/web/bootstrap/cache/*
!/apps/web/bootstrap/cache/.gitignore
/apps/web/public/storage
.phpunit.result.cache
.pest/

# --- Database & SQLite ---
*.sqlite
*.sqlite-journal
*.sqlite3
*.db
/apps/web/database/*.sqlite
/apps/web/database/*.sqlite-journal

# --- Android & Mobile (Expo / React Native) ---
local.properties
.expo/
.expo-shared/
web-build/
*.apk
*.aab
/apps/mobile/android/.gradle/
/apps/mobile/android/app/build/
/apps/mobile/android/build/
/apps/mobile/ios/Pods/
/apps/mobile/ios/build/

# --- OS & Editor ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
