{
  "expo": {
    "name": "kcal-log",
    "slug": "kcal-log",
    "version": "0.1.4",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#09090b",
    "splash": {
      "backgroundColor": "#09090b",
      "resizeMode": "contain"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#09090b",
      "translucent": false
    },
    "android": {
      "package": "com.kcallog.app",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#09090b"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow kcal-log to access your camera for barcode scanning."
        }
      ]
    ],
    "extra": {
      "repositoryFullName": "DevHolako/kcal-log",
      "appVersion": "0.1.4"
    }
  }
}
